// Effortless CRM - Database Schema
// PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  ADMIN
  MEMBER
}

// Niche is a free-form multi-select (String[]). Current values used in the UI:
// Golf, Talking, Omegle, Podcast, Dancing, Motion Control

enum Decision {
  KEEP
  REMOVE
  TESTING
}

enum Status {
  ACTIVE
  WARNING
  PAUSED
  BANNED
}

// Recreation progress for a saved marketing inspiration reel
enum InspirationStatus {
  IDEA
  RECREATING
  DONE
  ISSUE
}

// Whether an account is one of ours or a competitor we track for inspiration
enum Ownership {
  OWN
  COMPETITOR
}

// ============================================
// MODELS
// ============================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Model {
  id           String        @id @default(cuid())
  name         String
  photo        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  accounts     Account[]
  inspirations Inspiration[]
}

model Account {
  id          String      @id @default(cuid())
  username    String      @unique
  igUsername   String?     // Real Instagram username for scraping
  modelId     String?
  model       Model?      @relation(fields: [modelId], references: [id], onDelete: SetNull)
  phoneId     String?     // which physical iPhone this account lives on
  phone       Phone?      @relation(fields: [phoneId], references: [id], onDelete: SetNull)
  ownership   Ownership   @default(OWN)  // OWN = one of our models' accounts; COMPETITOR = a tracked rival
  niche       String[]    @default([])  // multi-select: Golf, Talking, Omegle, Podcast, Dancing, Motion Control
  decision    Decision?   // KEEP / REMOVE / TESTING
  status      Status      @default(ACTIVE)
  position    Int         @default(0)  // manual sort order (lower = higher in list)
  profileUrl  String?     // Instagram profile URL
  dateCreated DateTime    @default(now())     // when the CRM row was created
  accountCreatedDate DateTime?               // when the IG account itself was created
  lastPost    DateTime?   // date of the last post
  dateBanned  DateTime?
  followers   Int         @default(0)
  hasFacebook Boolean     @default(false)
  fbPageLink  String?
  linkInBio   Boolean     @default(false)
  login       String?     // sensitive: account login credentials
  notes       String?
  lastSyncedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  dailyStats  DailyStat[]
  reels       Reel[]
  snapshots   AccountSnapshot[]

  @@index([modelId])
  @@index([phoneId])
  @@index([status])
  @@index([decision])
  @@index([position])
  @@index([igUsername])
}

model DailyStat {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  instaViews Int      @default(0)
  fbViews    Int      @default(0)
  followers  Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([accountId, date])
  @@index([accountId])
  @@index([date])
}

// ============================================
// MARKETING / INSPIRATION
// ============================================

// A reel/post from another creator saved as inspiration to recreate
model Inspiration {
  id           String            @id @default(cuid())
  url          String            // link to the reel/post
  platform     String?           // instagram | tiktok | youtube | other (derived from url)
  creator      String?           // the other creator's handle/name
  title        String?           // short label / caption
  thumbnailUrl String?           @db.Text  // auto-fetched or manually pasted preview image
  niche        String[]          @default([])  // multi-select, reuses Account niches + custom
  notes        String?           @db.Text  // why I like it / why we should recreate it
  issueNote    String?           @db.Text  // when status = ISSUE: what's wrong / needs fixing
  addedBy      String?           // team member who saved this inspiration
  prompt       String?           @db.Text  // generated Seedance prompt (cached)
  thumbnailData    Bytes?        // cached preview image bytes (via the proxy pipeline)
  thumbnailType    String?       // content-type of the cached preview
  thumbnailTriedAt DateTime?     // last preview-fetch attempt (rate-limits retries)
  status       InspirationStatus @default(IDEA)  // recreation progress
  modelId      String?           // optional: which of our models this is for
  model        Model?            @relation(fields: [modelId], references: [id], onDelete: SetNull)
  folderId     String?           // optional: which folder (day / account) this reel is filed under
  folder       Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  position     Int               @default(0)  // manual sort order (lower = first)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([modelId])
  @@index([status])
  @@index([position])
  @@index([folderId])
}

// A folder in the marketing board. Folders can be nested (parent -> children) so you
// can have e.g. a "Jun 9" folder with "Main account" / "2nd main" subfolders inside.
model Folder {
  id           String        @id @default(cuid())
  name         String
  parentId     String?
  parent       Folder?       @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Folder[]      @relation("FolderTree")
  inspirations Inspiration[]
  position     Int           @default(0)  // manual sort order among siblings
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([parentId])
  @@index([position])
}

// A reel our VA made that turned out bad — logged so the team can learn from it.
// The video file lives in DigitalOcean Spaces; we keep only its object key here
// (the small Postgres instance can't hold video bytes).
model BadOutput {
  id        String   @id @default(cuid())
  videoKey  String              // Spaces object key of the uploaded reel
  aiUsed    String?             // which AI tool generated it
  niche     String[] @default([])
  issue     String?             // short label of what went wrong
  reason    String?  @db.Text   // why it's bad (explanation)
  notes     String?  @db.Text   // specific notes
  addedBy   String?             // team member who logged it
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// Reusable starting/reference images for image-to-video, organised into niche
// "folders". Copied from the CRM straight into Airtable's image field.
model ReferenceImage {
  id        String   @id @default(cuid())
  imageKey  String              // Spaces object key
  niche     String              // folder name (a niche, or anything custom)
  label     String?             // optional name/note
  addedBy   String?
  createdAt DateTime @default(now())

  @@index([niche])
  @@index([createdAt])
}

// An auto-recreation job: a source reel → Poppy image (image-edit workflow) →
// final reel (Motion-Control workflow), driven through the RUNNING-HUB Airtable
// base. The CRM acts as a "robot VA": it only CREATES rows + ticks START, then
// polls STATUS — it never edits/deletes existing Airtable data.
model Recreation {
  id             String   @id @default(cuid())
  sourceUrl      String              // the reel link to copy
  prompt         String   @db.Text   // image-edit prompt (fixed default, editable)
  status         String   @default("QUEUED") // QUEUED|PREPPING|IMAGE_WAIT|MOTION_WAIT|DONE|FAILED
  stage          String?             // short human-readable current step
  frameKey       String?             // Spaces key of the extracted first frame
  reelKey        String?             // Spaces key of the downloaded reel
  imageRecordId  String?             // Airtable image-edit record id
  poppyImageUrl  String?  @db.Text   // image-edit OUTPUT_URL (the Poppy image)
  motionRecordId String?             // Airtable Motion-Control record id
  finalVideoUrl  String?  @db.Text   // Motion-Control OUTPUT_URL (the finished reel)
  finalKey       String?             // Spaces key of the permanent reel copy
  captionJobId   String?             // in-flight async caption job on the prompt service
  driveUrl       String?  @db.Text   // Google Drive shareable link (if delivered)
  driveError     String?  @db.Text   // non-fatal: reel is done even if Drive push failed
  error          String?  @db.Text
  addedBy        String?             // team member who kicked it off
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Single-row store (id = "default") for the Google Drive OAuth refresh token,
// captured when the user clicks "Connect Google Drive". Kept in the DB (not env)
// because it's obtained at runtime via the OAuth callback.
model DriveAuth {
  id           String   @id
  refreshToken String   @db.Text
  email        String?
  updatedAt    DateTime @updatedAt
}

// A physical iPhone. Each holds several Instagram accounts (3–5), tracked so the
// team knows which account lives on which device.
model Phone {
  id        String    @id @default(cuid())
  name      String    // e.g. "iPhone 13 — black"
  notes     String?
  position  Int       @default(0)
  accounts  Account[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Tombstone of accounts you deleted, so the scraper's auto-linker can't resurrect
// them on the next scrape. Cleared automatically when an account is re-added.
model DeletedAccount {
  id         String   @id @default(cuid())
  igUsername String?
  username   String?
  deletedAt  DateTime @default(now())

  @@index([igUsername])
}

// ============================================
// INSTAGRAM SCRAPING MODELS
// ============================================

// Stores each individual reel for an account
model Reel {
  id              String    @id @default(cuid())
  accountId       String
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shortcode       String    // Instagram shortcode (e.g., "DYfeWm2TpUd")
  igMediaId       String?   // Instagram media ID if available
  thumbnailUrl    String?
  thumbnailData   Bytes?    // cached image bytes — survives Instagram's link expiry
  thumbnailType   String?   // content-type of the cached image (e.g. image/jpeg)
  caption         String?   @db.Text
  publishedAt     DateTime?
  currentViews    Int       @default(0)
  currentLikes    Int       @default(0)
  currentComments Int       @default(0)
  lastScrapedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  snapshots       ReelSnapshot[]
  analysis        ReelAnalysis?
  ideas           Idea[]

  @@unique([accountId, shortcode])
  @@index([accountId])
  @@index([shortcode])
}

// Hourly snapshots of each reel's metrics
model ReelSnapshot {
  id        String   @id @default(cuid())
  reelId    String
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  views     Int      @default(0)
  likes     Int      @default(0)
  comments  Int      @default(0)
  scrapedAt DateTime @default(now())

  @@index([reelId])
  @@index([scrapedAt])
}

// Hourly snapshots of account-level metrics (followers, etc.)
model AccountSnapshot {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  followers  Int      @default(0)
  following  Int      @default(0)
  postsCount Int      @default(0)
  scrapedAt  DateTime @default(now())

  @@index([accountId])
  @@index([scrapedAt])
}

// Stores the IG bot account session info
model ScraperConfig {
  id            String   @id @default(cuid())
  igUsername     String   @unique
  igPassword    String
  sessionData   String?  @db.Text  // serialized cookies/session
  lastLoginAt   DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Single-row control table the CRM uses to ask the VPS scraper for an on-demand
// run. The "Refresh now" button sets refreshRequestedAt; the scraper's frequent
// --if-requested check claims (clears) it and runs a full scrape.
model ScraperControl {
  id                 String    @id @default("singleton")
  refreshRequestedAt DateTime?
  updatedAt          DateTime  @updatedAt
}

// ============================================
// MARKETING INTELLIGENCE
// ============================================

// AI content analysis cached per reel (computed once, for top performers only).
// Auto-tags what's IN a reel so the idea engine can spot winning patterns.
model ReelAnalysis {
  id         String   @id @default(cuid())
  reelId     String   @unique
  reel       Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  hook       String?            // the opening hook
  themes     String[] @default([])  // ["golf","reveal","talking-to-camera","POV"]
  format     String?            // "swing reveal" | "talking" | "POV" | ...
  summary    String?  @db.Text  // one-line what-happens
  prompt     String?  @db.Text  // cached Seedance recreate prompt
  analyzedAt DateTime @default(now())
}

enum IdeaSource {
  MANUAL // added by a team member
  AI     // generated by the idea engine
}

enum IdeaStatus {
  NEW
  SAVED
  IN_PROGRESS
  DONE
  DISMISSED
}

// A marketing idea — manually added ("My Ideas") or AI-generated from what's working.
model Idea {
  id           String     @id @default(cuid())
  source       IdeaSource @default(AI)
  title        String
  concept      String?    @db.Text // the idea / why it'll work
  prompt       String?    @db.Text // ready-to-use Seedance prompt (if generated)
  isRecreate   Boolean    @default(false) // remake-a-winner vs novel concept
  sourceReelId String?
  sourceReel   Reel?      @relation(fields: [sourceReelId], references: [id], onDelete: SetNull)
  modelId      String? // optional: which of our models it's for
  status       IdeaStatus @default(NEW)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([source])
  @@index([status])
}
